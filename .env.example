# ============================================================================
# LUCKYDROP VIP — PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# SECURITY DIRECTIVE: Copy this file to `.env` on your VPS (`cp .env.example .env`).
# NEVER commit `.env` to GitHub or expose server secrets with a `VITE_` prefix!
# ============================================================================

# 1. SERVER RUNTIME & DOMAIN CONFIGURATION
NODE_ENV="production"
PORT="3000"
# Your public HTTPS domain (used for Telegram WebApp button, Stars webhook & CORS)
APP_DOMAIN="https://luckydrop.com"
APP_URL="https://luckydrop.com"

# 2. TELEGRAM BOT & MINI APP CRYPTOGRAPHIC SECURITY (SERVER-SIDE ONLY)
# Obtain from @BotFather on Telegram. NEVER prefix with VITE_!
TELEGRAM_BOT_TOKEN=""
# Secret token verified in `X-Telegram-Bot-Api-Secret-Token` header on `/api/telegram/webhook`
TELEGRAM_WEBHOOK_SECRET="generate_a_64_char_random_hex_secret_here"
# Set to "true" in production to reject any API mutation without a valid HMAC-SHA256 Telegram initData signature
STRICT_TELEGRAM_INITDATA_AUTH="false"

# 3. ADMIN RBAC & LIVE CHANNEL/GROUP NOTIFICATIONS
# Comma-separated numeric Telegram User IDs of authorized platform owners/admins
ADMIN_TELEGRAM_USER_IDS="778899101"
# Telegram Channel (@ChannelUsername) or Supergroup Chat ID (-100xxxxxxxxxx) for live alerts
TELEGRAM_NOTIFICATION_CHAT_ID=""

# 4. TON TREASURY & AUTOMATED WITHDRAWAL SECURITY GATE
# Official destination TON wallet address for automated TON Connect 2.0 deposits
PUBLIC_TON_TREASURY_WALLET="UQB_LuckyDrop_Official_TON_Vault_99x88_VIP"
# Withdrawals below this TON threshold settle automatically; >= this threshold require Admin approval
AUTO_WITHDRAW_LIMIT_TON="50"

# 5. OPTIONAL AI STUDIO / CLOUD SERVICES
GEMINI_API_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
