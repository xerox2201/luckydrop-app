rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'alierfani2200@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // 3. Entity Validation Helpers — STRICT DUAL-CURRENCY (tonBalance & starsBalance ONLY)
    // Clients can NEVER directly set or mutate tonBalance, starsBalance, vipTier, referralEarningsTon, or referralEarningsStars!
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'referralCode']) &&
             data.keys().hasOnly([
               'uid',
               'displayName',
               'vipTier',
               'tonBalance',
               'starsBalance',
               'connectedWallet',
               'telegramUsername',
               'referralCode',
               'referredByCode',
               'referralEarningsTon',
               'referralEarningsStars',
               'referredTicketsCount',
               'updatedAt'
             ]) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.referralCode is string && data.referralCode.size() >= 3 && data.referralCode.size() <= 32 &&
             (!('tonBalance' in data) || (data.tonBalance is number && data.tonBalance >= 0)) &&
             (!('starsBalance' in data) || (data.starsBalance is number && data.starsBalance >= 0)) &&
             (!('vipTier' in data) || (data.vipTier is string && data.vipTier.size() <= 40)) &&
             (!('connectedWallet' in data) || (data.connectedWallet is string && data.connectedWallet.size() <= 128)) &&
             (!('telegramUsername' in data) || (data.telegramUsername is string && data.telegramUsername.size() <= 64)) &&
             (!('referredByCode' in data) || (data.referredByCode is string && data.referredByCode.size() <= 32)) &&
             (!('referralEarningsTon' in data) || (data.referralEarningsTon is number && data.referralEarningsTon >= 0)) &&
             (!('referralEarningsStars' in data) || (data.referralEarningsStars is number && data.referralEarningsStars >= 0)) &&
             (!('referredTicketsCount' in data) || (data.referredTicketsCount is number && data.referredTicketsCount >= 0)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll(['TON']) &&
             data.keys().hasOnly([
               'TON',
               'COLD_TREASURY',
               'solvencyMode',
               'autoWithdrawLimitTon',
               'updatedAt'
             ]) &&
             data.TON is string && data.TON.size() >= 10 && data.TON.size() <= 128 &&
             (!('COLD_TREASURY' in data) || (data.COLD_TREASURY is string && data.COLD_TREASURY.size() <= 128)) &&
             (!('solvencyMode' in data) || (data.solvencyMode is string && data.solvencyMode.size() <= 32)) &&
             (!('autoWithdrawLimitTon' in data) || (data.autoWithdrawLimitTon is number && data.autoWithdrawLimitTon >= 1)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidReferralLink(data) {
      return data.keys().hasAll([
               'referralCode',
               'ownerUid',
               'ownerDisplayName',
               'referralUrl',
               'commissionRatePercent',
               'totalReferredTickets',
               'totalCommissionEarnedTon',
               'totalCommissionEarnedStars',
               'netHouseProfitRetainedTon'
             ]) &&
             data.keys().hasOnly([
               'referralCode',
               'ownerUid',
               'ownerDisplayName',
               'referralUrl',
               'commissionRatePercent',
               'totalReferredTickets',
               'totalCommissionEarnedTon',
               'totalCommissionEarnedStars',
               'netHouseProfitRetainedTon',
               'updatedAt'
             ]) &&
             data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.ownerDisplayName is string && data.ownerDisplayName.size() >= 1 && data.ownerDisplayName.size() <= 100 &&
             data.referralUrl is string && data.referralUrl.size() >= 8 && data.referralUrl.size() <= 256 &&
             data.commissionRatePercent is number && data.commissionRatePercent >= 0 && data.commissionRatePercent <= 3 &&
             data.totalReferredTickets is number && data.totalReferredTickets >= 0 &&
             data.totalCommissionEarnedTon is number && data.totalCommissionEarnedTon >= 0 &&
             data.totalCommissionEarnedStars is number && data.totalCommissionEarnedStars >= 0 &&
             data.netHouseProfitRetainedTon is number && data.netHouseProfitRetainedTon >= 0 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidLedgerEntry(data) {
      return data.keys().hasAll([
               'playerId',
               'currency',
               'amountTon',
               'amountStars',
               'tonBalanceBefore',
               'tonBalanceAfter',
               'starsBalanceBefore',
               'starsBalanceAfter'
             ]) &&
             (data.currency == 'TON' || data.currency == 'STARS') &&
             data.amountTon is number && data.amountTon >= 0 &&
             data.amountStars is number && data.amountStars >= 0 &&
             data.tonBalanceBefore is number && data.tonBalanceBefore >= 0 &&
             data.tonBalanceAfter is number && data.tonBalanceAfter >= 0 &&
             data.starsBalanceBefore is number && data.starsBalanceBefore >= 0 &&
             data.starsBalanceAfter is number && data.starsBalanceAfter >= 0;
    }

    // 4. Collection Rules — ZERO CLIENT-SIDE FINANCIAL MUTATION
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isVerifiedAdmin());
      allow list: if isVerifiedAdmin();
      // Clients creating a profile cannot inject a non-zero tonBalance, starsBalance, or referral earnings
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                    isValidUserProfile(incoming()) && incoming().uid == request.auth.uid && (
                      isVerifiedAdmin() ||
                      (
                        (!('tonBalance' in incoming()) || incoming().tonBalance == 0) &&
                        (!('starsBalance' in incoming()) || incoming().starsBalance == 0) &&
                        (!('referralEarningsTon' in incoming()) || incoming().referralEarningsTon == 0) &&
                        (!('referralEarningsStars' in incoming()) || incoming().referralEarningsStars == 0) &&
                        (!('referredTicketsCount' in incoming()) || incoming().referredTicketsCount == 0)
                      )
                    );
      // Clients can NEVER modify tonBalance, starsBalance, vipTier, referralEarningsTon, referralEarningsStars, or referredTicketsCount!
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) &&
                    incoming().uid == existing().uid && (
                      isVerifiedAdmin() ||
                      (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly([
                        'displayName',
                        'connectedWallet',
                        'telegramUsername',
                        'referralCode',
                        'referredByCode',
                        'updatedAt'
                      ]))
                    );
      allow delete: if false;
    }

    // Treasury & Platform Settings: Publicly readable, strictly Admin-only write
    match /settings/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow create, update: if isVerifiedAdmin() && isValidId(docId) && isValidPlatformSettings(incoming());
      allow delete: if false;
    }

    match /treasury/{docId} {
      allow get: if isVerifiedAdmin();
      allow list, create, update, delete: if isVerifiedAdmin();
    }

    // PAM Ledger (Strictly TON & Stars), Lottery Tickets, Deposits, Withdrawals & Draws: Strictly Server/Admin Write Only!
    match /ledger/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && (resource.data.playerId == request.auth.uid || isVerifiedAdmin());
      allow list: if isVerifiedAdmin();
      allow create, update: if isVerifiedAdmin() && isValidLedgerEntry(incoming());
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (resource.data.userUid == request.auth.uid || isVerifiedAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isVerifiedAdmin());
      allow create, update, delete: if isVerifiedAdmin();
    }

    match /draws/{drawId} {
      allow get, list: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    match /deposits/{depositId} {
      allow get: if isSignedIn() && isValidId(depositId) && (resource.data.userUid == request.auth.uid || isVerifiedAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isVerifiedAdmin());
      allow create, update, delete: if isVerifiedAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && isValidId(withdrawalId) && (resource.data.userUid == request.auth.uid || isVerifiedAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isVerifiedAdmin());
      allow create, update, delete: if isVerifiedAdmin();
    }

    match /referrals/{referralCode} {
      allow get: if isValidId(referralCode);
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isVerifiedAdmin());
      allow create: if isSignedIn() && isValidId(referralCode) && isValidReferralLink(incoming()) &&
                    incoming().referralCode == referralCode &&
                    incoming().ownerUid == request.auth.uid && (
                      isVerifiedAdmin() ||
                      (
                        incoming().totalCommissionEarnedTon == 0 &&
                        incoming().totalCommissionEarnedStars == 0 &&
                        incoming().totalReferredTickets == 0
                      )
                    );
      allow update: if isSignedIn() && isValidId(referralCode) && isValidReferralLink(incoming()) &&
                    incoming().referralCode == existing().referralCode &&
                    incoming().ownerUid == existing().ownerUid && (
                      isVerifiedAdmin() ||
                      (request.auth.uid == existing().ownerUid && incoming().diff(existing()).affectedKeys().hasOnly([
                        'ownerDisplayName',
                        'referralUrl',
                        'updatedAt'
                      ]))
                    );
      allow delete: if false;
    }

    match /referralCommissions/{commissionId} {
      allow get: if isSignedIn() && isValidId(commissionId) && (resource.data.buyerUid == request.auth.uid || isVerifiedAdmin());
      allow list: if isSignedIn() && (resource.data.buyerUid == request.auth.uid || isVerifiedAdmin());
      allow create, update, delete: if isVerifiedAdmin();
    }
  }
}
